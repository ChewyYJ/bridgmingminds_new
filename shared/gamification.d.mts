export type ActivityType = 'daily_practice' | 'read_aloud' | 'ai_debate' | 'read_reflect' | 'vocabulary_review';
export type Collection = 'boy' | 'girl';
export type EquipmentCategory = 'hair' | 'hat' | 'top' | 'jacket' | 'bottom' | 'shoes' | 'accessory';
export type EquipmentSelection = { collection: Collection; skin: string; hairColor: string; eyeColor: string;
  hair: string; hat: string | null; top: string; jacket: string | null; bottom: string; shoes: string; accessory: string | null };
export type Streak = { current: number; longest: number; securedToday: boolean };
export type UnlockRule = { type: 'starter' | 'activity'; metric: string; target: number; description: string };
export type CatalogItem = { id: string; itemId: string; name: string; category: EquipmentCategory; collection: Collection;
  index: number; assetRef: string; layer: string; unlockRule: UnlockRule; price: number | null; purchasable: boolean; owned: boolean; progress: number };
export type Food = { id: string; name: string; cost: number; fullness: number; animation: 'eat' | 'eatOnigiri' | 'eatBento'; assetRef: string };
export type Achievement = { id: string; title: string; description: string; metric: string; target: number; progress: number; earnedAt: string | null };
export type EconomyConfig = { version: number; id: string; approvalStatus: string; foodCost: number; xpPerLevel: number;
  initialFullness: number; fullnessMaximum: number; fullnessDecayPerHour: number; careEnabledByDefault: boolean;
  legacyConversion: { policyId: string; coinsPerSeed: number };
  rewards: Record<ActivityType, { coins: number; xp: number; dailyCap: number }>;
  streakMilestones: readonly { days: number; coins: number; xp: number }[];
  cosmeticPrices: Readonly<Record<EquipmentCategory, readonly (number | null)[]>> };
export type GamificationSummary = { version: 1; coins: number; xp: number; level: number;
  levelProgress: { current: number; required: number }; streak: Streak; timezone: string;
  avatar: { selection: EquipmentSelection; ownedItemIds: string[] }; catalog: CatalogItem[]; foods: readonly Food[];
  fullness: { value: number; max: number; careEnabled: boolean; remindersEnabled: boolean };
  achievements: Achievement[]; legacy: { status: string; archivedAt: string; message: string }; config: EconomyConfig };
export type RewardReceipt = { ledgerTransactionId: string; eventId: string; activityType: ActivityType;
  coinsGranted: number; xpGranted: number; balance: number; level: number; streak: Streak;
  unlockedItems: string[]; achievements: string[]; alreadyProcessed: boolean; eligible: boolean; reason: string; localDate: string };
export type FoodPurchaseReceipt = { transactionId: string; foodId: string; food: Pick<Food,'id'|'name'|'animation'>;
  coinsSpent: number; balance: number; fullness: number; fullnessRestored: number; animation: Food['animation']; alreadyProcessed: boolean; state: GamificationSummary };
export type AvatarPurchaseReceipt = { transactionId: string; item: { id: string; name: string };
  coinsSpent: number; alreadyProcessed: boolean; state: GamificationSummary };
export const GAMIFICATION_CONFIG: Readonly<EconomyConfig>;
export const FOODS: readonly Food[];
export const ITEM_CATALOG: readonly Omit<CatalogItem,'owned'|'progress'>[];
export const ACHIEVEMENTS: readonly Omit<Achievement,'progress'|'earnedAt'>[];
export const AVATAR_PALETTES: Readonly<Record<'skin'|'hairColor'|'eyeColor', readonly string[]>>;
export const EQUIPMENT_CATEGORIES: readonly EquipmentCategory[];
export const OPTIONAL_EQUIPMENT: readonly EquipmentCategory[];
export function defaultEquipment(collection?: Collection): EquipmentSelection;
export function levelProgress(xp: number): { level: number; current: number; required: number };
