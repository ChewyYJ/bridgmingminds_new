{
  "expo": {
    "name": "BridgingMinds",
    "slug": "mind-garden",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/bridgingminds-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.mindgarden.practice"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/bridgingminds-adaptive.png",
        "monochromeImage": "./assets/brand/bridgingminds-monochrome.png",
        "backgroundColor": "#FAF8F5"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.mindgarden.practice"
    },
    "web": {
      "favicon": "./assets/brand/bridgingminds-favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Record a practice response in BridgingMinds. You can always choose to write instead.",
          "enableBackgroundRecording": false
        }
      ],
      "expo-secure-store",
      "expo-asset",
      "expo-sharing"
    ],
    "scheme": "mindgarden"
  }
}
